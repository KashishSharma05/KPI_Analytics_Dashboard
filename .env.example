# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection: postgresql+psycopg2://USER@HOST:PORT/DATABASE
# (local Homebrew PostgreSQL 14 on port 5433, no password needed)
DATABASE_URL=postgresql+psycopg2://your_mac_username@localhost:5433/olist_analytics

# Google Gemini API key (needed from Phase 5)
GEMINI_API_KEY=

# Email alert settings (needed from Phase 8)
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_TO=
